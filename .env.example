# ==============================================================================
# FICHIER D'EXEMPLE DE CONFIGURATION - PLATEFORME AYA
# Copiez ce fichier en '.env' et complétez les valeurs réelles.
# Ne jamais committer le fichier '.env' réel contenant des clés privées.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clés d'Inférence IA (LLM & Vision)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Ingestion & Sauvegarde Google Drive (Master Drive Admin)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ------------------------------------------------------------------------------
# 3. GitHub Feedback Connector (Agent Jim / Retours Utilisateurs)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_OWNER=artas971
GITHUB_REPO=plateforme-aya

# ------------------------------------------------------------------------------
# 4. Sécurité & Authentification des Testeurs
# ------------------------------------------------------------------------------
AYA_ACCESS_CODE=Gaza2026
SESSION_SECRET=your_super_secret_session_key_here

# ------------------------------------------------------------------------------
# 5. Base de Données MongoDB (Phase 2)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/plateforme_aya

# ------------------------------------------------------------------------------
# 6. Pont Telegram (Ingestion de Médias)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_USERNAME="your_telegram_bot_username_here"

# ------------------------------------------------------------------------------
# 7. Moteur Acoustique Google Cloud Chirp 2 (Phase 3B - Agent Levantin)
# ------------------------------------------------------------------------------
ENABLE_CHIRP_STT=true
GCP_STT_LOCATION=us-central1
GCP_STT_MODEL=chirp_2
GCP_STT_LANG=ar-PS

# ------------------------------------------------------------------------------
# 8. Architecture Dual-Environment & Mode Dégradé FFmpeg (Phase 3C)
# ------------------------------------------------------------------------------
# Mode Local (Tech Lead PC) : development / local / local_high_perf
# Mode Production (Serveur VPS) : production / production / cloud_vps_safe
NODE_ENV=development
PYTHON_ENV=local
AYA_EXEC_PROFILE=local_high_perf
FFMPEG_MAX_THREADS=0
FFMPEG_PRESET=veryfast
FFMPEG_CRF=22

# ------------------------------------------------------------------------------
# 9. Intégration TikTok Publishing API (Phase 3A - Direct Post & Schedule)
# ------------------------------------------------------------------------------
# Clés d'API générées sur le portail TikTok for Developers
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# URL de redirection OAuth2 :
# En local (Tech Lead) : URL dynamique Ngrok (ex: https://xxxx.ngrok-free.app/api/tiktok/auth/callback)
# En production (VPS)  : URL publique du domaine (ex: https://plateforme-aya.org/api/tiktok/auth/callback)
TIKTOK_CALLBACK_URL=

# Clé de chiffrement AES-256-GCM (256 bits / 64 caractères hexadécimaux)
# Utilisée par l'Agent Victor pour chiffrer les Access & Refresh Tokens en base
TIKTOK_TOKEN_ENCRYPTION_KEY=your_256_bit_hex_encryption_key_here
