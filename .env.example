# ==============================================================================
# FICHIER D'EXEMPLE DE CONFIGURATION EXHAUSTIF - PLATEFORME AYA
# Hébergement cible : Hetzner Cloud VPS (Ubuntu 24.04 LTS / Node 20 LTS)
# Copiez ce fichier en '.env' et complétez les valeurs réelles.
# Ne jamais committer le fichier '.env' réel contenant des secrets ou clés privées.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVEUR WEB, RÉSEAU & SÉCURITÉ DE BASE
# ------------------------------------------------------------------------------
# Port d'écoute interne du serveur Node.js (derrière Nginx Reverse Proxy)
PORT=3000

# Environnement d'exécution Node.js ('development' en local, 'production' sur Hetzner)
NODE_ENV=production

# Clé secrète de chiffrement des sessions utilisateur Express-Session
SESSION_SECRET=votre_cle_secrete_aleatoire_tres_longue_production_2026

# Code d'accès maître pour l'inscription des testeurs et créateurs
AYA_ACCESS_CODE=Gaza2026

# Adresse e-mail du Super-Administrateur (autorisée pour la modération et dashboard)
ADMIN_EMAIL=artas971@gmail.com

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES PERSISTANTE (MongoDB)
# ------------------------------------------------------------------------------
# Chaîne de connexion MongoDB (Mongoose)
# Local : mongodb://127.0.0.1:27017/plateforme_aya
# Production Hetzner : mongodb://aya_user:mot_de_passe_robuste@127.0.0.1:27017/plateforme_aya?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/plateforme_aya

# ------------------------------------------------------------------------------
# 3. MOTEURS D'INTELLIGENCE ARTIFICIELLE (LLM & VISION)
# ------------------------------------------------------------------------------
# Clé API Google Gemini (utilisée pour la traduction sémantique Shami, fiches de vocabulaire)
GEMINI_API_KEY=votre_cle_api_google_gemini_ici

# Clé API OpenAI (modèles GPT-4o / GPT-4o-mini / Whisper fallback)
OPENAI_API_KEY=sk-proj-votre_cle_api_openai_ici

# ------------------------------------------------------------------------------
# 4. RECONNAISSANCE VOCALE & MOTEUR ACOUSTIQUE SHAMI (Google Cloud STT)
# ------------------------------------------------------------------------------
# Activer le moteur Google Cloud Speech-to-Text Chirp 2 (dialecte levantin ar-PS)
ENABLE_CHIRP_STT=true
GCP_STT_LOCATION=us-central1
GCP_STT_MODEL=chirp_2
GCP_STT_LANG=ar-PS

# ------------------------------------------------------------------------------
# 5. PIPELINE SYSTÈME, PYTHON & GESTION DES RESSOURCES HETZNER
# ------------------------------------------------------------------------------
# Binaire Python (ex: 'python3' ou '/usr/bin/python3' sur Linux Ubuntu Hetzner, 'py' ou 'python' sur Windows)
PYTHON_BIN=/usr/bin/python3
PYTHON_ENV=production

# Profil d'exécution ('cloud_vps_safe' sur VPS Hetzner, 'local_high_perf' sur PC Tech Lead)
AYA_EXEC_PROFILE=cloud_vps_safe

# Priorité d'ordonnancement système Linux (nice -n 15 pour préserver la réactivité CPU sous charge FFmpeg)
AYA_NICE_PRIORITY=15

# Emplacement de l'exécutable Chromium/Chrome pour Puppeteer headless (Fiches Vocabulaire)
# Sur Hetzner Ubuntu : /usr/bin/chromium ou /usr/bin/google-chrome-stable
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_BIN=/usr/bin/chromium

# ------------------------------------------------------------------------------
# 6. ENCODAGE VIDÉO, SOUS-TITRAGE & FFMPEG
# ------------------------------------------------------------------------------
# Nombre max de threads FFmpeg (0 = automatique / threads optimisés sur VPS multi-cœurs)
FFMPEG_MAX_THREADS=2
FFMPEG_PRESET=veryfast
FFMPEG_CRF=22

# ------------------------------------------------------------------------------
# 7. MONÉTISATION, PORTEFEUILLE & STRIPE CHECKOUT
# ------------------------------------------------------------------------------
# Clé secrète Stripe (mode Test sk_test_... ou mode Live sk_live_...)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe_ici

# Secret du Webhook Stripe pour valider la signature des événements de paiement
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_stripe_ici

# ------------------------------------------------------------------------------
# 8. PUBLICATION TIKTOK API (Créateur & Studio)
# ------------------------------------------------------------------------------
# Identifiants développeur TikTok for Developers
TIKTOK_CLIENT_KEY=votre_tiktok_client_key
TIKTOK_CLIENT_SECRET=votre_tiktok_client_secret

# URL de redirection OAuth2 TikTok
# Local : https://xxxx.ngrok-free.app/api/tiktok/auth/callback
# Prod Hetzner : https://plateforme-aya.org/api/tiktok/auth/callback
TIKTOK_CALLBACK_URL=https://plateforme-aya.org/api/tiktok/auth/callback

# Clé de chiffrement AES-256-GCM (hexadécimal 64 caractères) pour sécuriser les tokens TikTok
TIKTOK_TOKEN_ENCRYPTION_KEY=votre_cle_chiffrement_aes_256_gcm_64_caracteres_hex

# ------------------------------------------------------------------------------
# 9. GOOGLE DRIVE MASTER & CLOUD STORAGE
# ------------------------------------------------------------------------------
# Fichier de compte de service Google pour ingestion automatique
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
GOOGLE_DRIVE_FOLDER_ID=votre_id_dossier_google_drive_ici

# Identifiants OAuth2 Google (si flux utilisateur actif)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_REDIRECT_URI=https://plateforme-aya.org/oauth2callback
GOOGLE_REFRESH_TOKEN=votre_google_oauth_refresh_token

# ------------------------------------------------------------------------------
# 10. WEBHOOKS EXTERNES, NOTIFICATIONS & RETOURS (Agents Jim & Victor)
# ------------------------------------------------------------------------------
# Connecteur GitHub Issues pour les feedbacks utilisateurs
GITHUB_TOKEN=ghp_votre_github_personal_access_token_ici
GITHUB_OWNER=artas971
GITHUB_REPO=plateforme-aya

# Webhooks de notification (optionnels)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx/yyyy/zzzz

# Pont Telegram (optionnel - Bot de notification & transfert média)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=aya_notifications_bot
