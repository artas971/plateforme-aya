# =======================================================
# Configuration des clés API Cloud - Plateforme Aya
# (Ne jamais renseigner de clés privées dans ce fichier .example)
# =======================================================

# Clé API Google Gemini (Priorité 1 : Transcription et Traduction multimodale directe via gemini-2.5-flash)
GEMINI_API_KEY=votre_cle_gemini_ici

# Clé API OpenAI (Priorité 2 : Fallback Cloud via Whisper API / GPT-4o-mini sans charge CPU)
OPENAI_API_KEY=votre_cle_openai_ici

# Clé API Anthropic (Optionnel : Fallback Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# =======================================================
# Ingestion Automatisée Google Drive (Compte de Service)
# =======================================================
# Chemin vers le fichier JSON de clé du Service Account Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json

# ID du dossier Google Drive partagé (extrait de l'URL du dossier Drive)
GOOGLE_DRIVE_FOLDER_ID=votre_folder_id_drive_ici
